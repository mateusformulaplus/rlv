generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Order {
  pagbankOrderId String   @id
  data           Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("orders")
}

model MelhorEnvioCredential {
  id          String    @id
  accessToken String
  expiresAt   DateTime?
  updatedAt   DateTime  @updatedAt

  @@map("melhor_envio_credentials")
}

model MelhorEnvioOAuthState {
  state     String   @id
  expiresAt DateTime

  @@map("melhor_envio_oauth_states")
}
