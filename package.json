{
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "postinstall": "prisma generate --schema=./prisma/schema.prisma",
    "db:generate": "dotenv -e ./config/.env -- prisma generate",
    "db:push": "dotenv -e ./config/.env -- prisma db push && node scripts/enable-rls.js",
    "db:secure": "node scripts/enable-rls.js",
    "db:seed-admin": "node scripts/seed-admin.js",
    "db:backfill-expedicao": "node scripts/backfill-expedicao.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@prisma/client": "^6.19.0",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.11.2",
    "prisma": "^6.19.0",
    "resend": "^6.32.0"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0"
  }
}
